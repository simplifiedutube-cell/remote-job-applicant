# Copy to .env and edit. .env is gitignored; this file is not.

# ---------------------------------------------------------------- core
JOBAGENT_DB_DSN=postgresql://jobagent:jobagent@localhost:5433/jobagent
JOBAGENT_TEST_DSN=postgresql://jobagent:jobagent@localhost:5433/jobagent_test
JOBAGENT_ARTIFACT_DIR=./artifacts
JOBAGENT_EXPORT_DIR=./exports
JOBAGENT_LOG_LEVEL=INFO
JOBAGENT_LOG_JSON=false

# ---------------------------------------------------------------- SAFETY
# Guardrail 3. Dry-run is the default and there is no --dry-run flag; there is a
# --live flag. BOTH of the following must flip before a single real submit happens:
#   1. JOBAGENT_DRY_RUN=false  (or --live on the command line)
#   2. JOBAGENT_ALLOW_LIVE=1
# A CLI flag alone cannot go live. A stray env var alone cannot go live.
JOBAGENT_DRY_RUN=true
JOBAGENT_ALLOW_LIVE=0

# ---------------------------------------------------------------- screener (M3)
# Your spec: "set it high (75+) and let the agent apply to fewer, better-matched roles."
JOBAGENT_FIT_THRESHOLD=75

# ---------------------------------------------------------------- LLM (M3/M4/M7)
# Default provider is the Claude Code SDK, which uses your existing Claude Code
# login -- no separate API billing. Set JOBAGENT_LLM_PROVIDER=anthropic_api and
# supply ANTHROPIC_API_KEY only if you want to switch to metered API access.
JOBAGENT_LLM_PROVIDER=claude_code
JOBAGENT_LLM_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- embeddings (M2/M4)
# 384 dimensions is baked into the DDL. Changing model = an Alembic migration.
JOBAGENT_EMBED_MODEL=BAAI/bge-small-en-v1.5
JOBAGENT_EMBED_DIM=384
JOBAGENT_REPOST_COSINE_THRESHOLD=0.92

# ---------------------------------------------------------------- render (M4)
# Absent on this machine. `brew install --cask libreoffice` to enable PDF output;
# until then the apply lanes upload .docx, which Greenhouse/Lever/Ashby all accept.
JOBAGENT_SOFFICE_BIN=/Applications/LibreOffice.app/Contents/MacOS/soffice

# ---------------------------------------------------------------- browser (M6)
# Cookies only, written by `jobagent login <portal>` after YOU log in by hand.
# Credentials are never stored, never typed, never read by this program.
JOBAGENT_STORAGE_STATE_DIR=./secrets/storage_state
JOBAGENT_MAX_APPLIES_PER_PORTAL_PER_DAY=10
JOBAGENT_PACE_MIN_SECONDS=30
JOBAGENT_PACE_MAX_SECONDS=120

# ---------------------------------------------------------------- notify (M7)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GMAIL_CREDENTIALS_JSON=./secrets/gmail_client_secret.json
GMAIL_TOKEN_JSON=./secrets/gmail_token.json
JOBAGENT_DIGEST_HOUR=20
